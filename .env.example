# GUARDDOG — environment template. Copy to .env and fill. NEVER commit .env
# --- Sentinel (honeypot decoys) ---
BASE_SEPOLIA_RPC=https://sepolia.base.org
SENTINEL_OPERATOR_KEY=          # EVM key that funds/deploys decoys (testnet only!)
DECOY_COUNT=5
# --- NEAR (registry + chain signatures) ---
# Values below verified live on testnet, 2026-10-20 (task T2):
# account guarddog-sentinel.testnet funded via the official docs faucet
# (https://docs.near.org/getting-started/faucet -> faucet-near-testnet.onrender.com)
# contract deployed from registry/ (cargo build --target wasm32-unknown-unknown --release)
NEAR_ACCOUNT_ID=guarddog-sentinel.testnet
NEAR_PRIVATE_KEY=ed25519:...    # stored in keys/near.json (chmod 600, gitignored)
NEAR_RPC=https://rpc.testnet.near.org
SENTINEL_REGISTRY_CONTRACT=guarddog-sentinel.testnet
# MPC contract on testnet — verified: docs.near.org chain-signatures + live
# `public_key` view call returns the secp256k1 key hardcoded in the registry.
MPC_CONTRACT=v1.signer-prod.testnet
MPC_PUBLIC_KEY=secp256k1:4NfTiv3UsGahebgTaHyD9vF8KYKMBnfd6kh94mK6xv8fGBiJB8TBtFMP5WWXz6B89Ac1fbpzPwAvoyQebemHFwx3
# --- Leash (signing-layer firewall) ---
LEASH_POLICY_PATH=./config/leash_policy.json
LEASH_DAILY_CAP_USD=500
LEASH_PER_TX_CAP_USD=100
# --- Telegram (owner-only) ---
TG_BOT_TOKEN=
TG_OWNER_CHAT_ID=1368730042

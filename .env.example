# GUARDDOG — environment template. Copy to .env and fill. NEVER commit .env
# --- Sentinel (honeypot decoys) ---
BASE_SEPOLIA_RPC=https://sepolia.base.org
SENTINEL_OPERATOR_KEY=          # EVM key that funds/deploys decoys (testnet only!)
DECOY_COUNT=5
# --- NEAR (registry + chain signatures) ---
NEAR_ACCOUNT_ID=guarddog.testnet
NEAR_PRIVATE_KEY=ed25519:...
NEAR_RPC=https://rpc.testnet.near.org
SENTINEL_REGISTRY_CONTRACT=guarddog-registry.testnet
MPC_CONTRACT=v1.signer-prod.testnet   # verify actual MPC contract address at T2
# --- Leash (signing-layer firewall) ---
LEASH_POLICY_PATH=./config/leash_policy.json
LEASH_DAILY_CAP_USD=500
LEASH_PER_TX_CAP_USD=100
# --- Telegram (owner-only) ---
TG_BOT_TOKEN=
TG_OWNER_CHAT_ID=1368730042
